# Required: Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Optional: Get from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Get from https://console.groq.com/keys (Free high-speed AI)
GROQ_API_KEY=your_groq_api_key_here

# Bot Settings
FREE_DAILY_LIMIT=10
BOT_NAME=Charm Bot

# AI model names (optional overrides)
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash
GROQ_MODEL=openai/gpt-oss-120b

# Your Telegram user ID (send /myid to the bot) — allows /addpack
ADMIN_USER_ID=

# Sticker packs for bot replies (names from t.me/addstickers/<name>, comma-separated)
STICKER_PACKS=nkosip_mini
